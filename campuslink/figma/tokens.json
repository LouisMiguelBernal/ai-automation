{
  "$description": "CampusLink concept — design tokens (W3C / Tokens Studio format). Colors sampled from 806technologies.com on 2026-11-11.",
  "color": {
    "brand": {
      "navy": { "$type": "color", "$value": "#0E3B7D", "$description": "Primary — sidebar, headings, secondary buttons" },
      "navy-900": { "$type": "color", "$value": "#0A2B5C" },
      "blue": { "$type": "color", "$value": "#0062AD", "$description": "Links, data bars, icons" },
      "sky": { "$type": "color", "$value": "#83B7EA", "$description": "Gradient start — background only, fails AA as text" },
      "sky-100": { "$type": "color", "$value": "#DBE9F8" },
      "pale": { "$type": "color", "$value": "#EBEFF6", "$description": "Page background, soft fills" },
      "green": { "$type": "color", "$value": "#8AC343", "$description": "Primary CTA — one per screen, navy-900 text" },
      "red": { "$type": "color", "$value": "#CD201F", "$description": "806 logo accent only — never for UI states" }
    },
    "text": {
      "ink": { "$type": "color", "$value": "#33373D" },
      "muted": { "$type": "color", "$value": "#69727D" }
    },
    "line": { "$type": "color", "$value": "#DDE3EC" },
    "status": {
      "ok": { "$type": "color", "$value": "#2F6B12" },
      "ok-bg": { "$type": "color", "$value": "#EAF5DD" },
      "warn": { "$type": "color", "$value": "#8A5A00" },
      "warn-bg": { "$type": "color", "$value": "#FFF4DB" },
      "danger": { "$type": "color", "$value": "#B42318" },
      "danger-bg": { "$type": "color", "$value": "#FDECEA" }
    }
  },
  "gradient": {
    "hero": { "$type": "gradient", "$value": [{ "color": "#83B7EA", "position": 0 }, { "color": "#0E3B7D", "position": 1 }] },
    "soft": { "$type": "gradient", "$value": [{ "color": "#EBEFF6", "position": 0 }, { "color": "#FFFFFF", "position": 1 }] }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Figtree", "$description": "Free stand-in for 806's licensed Soleil" },
    "size": {
      "display": { "$type": "dimension", "$value": "48px" },
      "h1": { "$type": "dimension", "$value": "30px" },
      "h2": { "$type": "dimension", "$value": "24px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "small": { "$type": "dimension", "$value": "14px" },
      "caption": { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "radius": {
    "button": { "$type": "dimension", "$value": "0px", "$description": "Square, matches 806 site" },
    "card": { "$type": "dimension", "$value": "0px" },
    "pill": { "$type": "dimension", "$value": "0px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "size": {
    "tap-target": { "$type": "dimension", "$value": "44px", "$description": "Minimum interactive height (WCAG 2.5.5)" }
  }
}
